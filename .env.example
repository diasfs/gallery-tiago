POSTGRES_USER=gallery
POSTGRES_PASSWORD=gallery
POSTGRES_DB=gallery
DATABASE_URL=postgresql://gallery:gallery@postgres:5432/gallery?serverVersion=16&charset=utf8
REDIS_URL=redis://redis:6379
APP_SECRET=change-me-in-production
FACE_MATCH_THRESHOLD=0.35
FACE_CLUSTER_THRESHOLD=0.40
MERGE_SUGGESTIONS_MAX_CLUSTERS=500
FACE_EMBEDDING_DIM=512
FACES_EMBED_PORT=8090
FACES_EMBED_URL=http://worker-faces:8090
TAG_MAX_COUNT=10
TAG_SCORE_THRESHOLD=0.0
MOBILECLIP_SCORE_THRESHOLD=0.20
MEDIA_ROOT=/var/gallery/media

# Public site origin (SPA). Fallback for share previews when the request has no
# public Host / X-Forwarded-Host (CLI, tests). With Vite/nginx, the live Host is used.
PUBLIC_SITE_URL=http://localhost:5173

# Live gallery v3 MySQL for `php bin/console app:import-v3`
# Example: mysql://gallery_new:gallery_new@gallery.meuser.com.br:3306/gallery
V3_DATABASE_URL=

# Leave empty for same-origin requests through the Vite dev-server proxy —
# required for the admin session cookie to work without CORS.
VITE_API_BASE_URL=

# Inside docker-compose, the frontend container proxies to the `api` service
# by name (not `localhost:8081`, which is only reachable from the host).
VITE_API_PROXY_TARGET=http://api
