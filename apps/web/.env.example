# Leave empty for same-origin requests through the Vite dev-server proxy
# (see vite.config.ts's server.proxy) — required for the admin session
# cookie to work without CORS. Only set this to a URL if you intentionally
# want the SPA to call a cross-origin API (and have CORS configured there).
VITE_API_BASE_URL=

# Where the Vite dev-server proxy forwards `/api`, `/converted`, and
# `/originals` requests. Defaults to http://localhost:8081, which is correct
# when running `bun run dev` outside docker compose.
VITE_API_PROXY_TARGET=http://localhost:8081
